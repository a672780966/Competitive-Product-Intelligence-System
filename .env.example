# ==========================================
# CPIS V1 — Environment Variables
# ==========================================
# Copy this file to .env and adjust values.
#   cp .env.example .env

# --- General ---
APP_NAME=CPIS V1
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=production
SECRET_KEY=change-this-to-a-random-string

# --- Database ---
# PostgreSQL in Docker: postgresql+asyncpg://cpis:password@postgres:5432/cpis
# Local dev:           postgresql+asyncpg://cpis:cpis@localhost:5432/cpis
DATABASE_URL=postgresql+asyncpg://cpis:${DB_PASSWORD:-cpis}@postgres:5432/cpis
DB_PASSWORD=cpis

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- AI (LLM) ---
# Supports OpenAI-compatible APIs (OpenAI, Azure, Ollama, vLLM, LocalAI, etc.)
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_BASE_URL=

# --- Feishu ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_TOKEN=

# --- Collection ---
COLLECTION_TIMEOUT_SECONDS=60
COLLECTION_MAX_RETRIES=3
