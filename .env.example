# ==========================================
# CPIS V1 — Environment Variables
# ==========================================
# Copy this file to .env and adjust values.

# --- General ---
APP_NAME=CPIS V1
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://cpis:cpis@localhost:5432/cpis
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- AI (LLM) ---
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o
LLM_BASE_URL=

# --- Feishu ---
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_TOKEN=

# --- Collection ---
COLLECTION_TIMEOUT_SECONDS=60
COLLECTION_MAX_RETRIES=3
